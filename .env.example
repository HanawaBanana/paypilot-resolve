# PayPilot Resolve — configuration
# mock    = deterministic local platform: runs with zero credentials, no network
# sandbox = the real PayPal sandbox REST API (sandbox credentials only)
PAYPILOT_MODE=mock

# Sandbox app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Never commit the real file.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Where PayPal sends the operator back after the buyer approves (return_url).
APP_BASE_URL=http://127.0.0.1:8000

# Optional: an OpenAI-compatible endpoint used by the planner. Without it the
# app runs in labelled rules mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local overrides (git-ignored)
PAYPILOT_DB=
PAYPILOT_RECIPIENTS=recipients.json
